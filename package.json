{
  "name": "next-seo-schema",
  "version": "0.1.0",
  "description": "Typed JSON-LD structured data for Next.js App Router with absolute-URL validation.",
  "keywords": [
    "nextjs",
    "seo",
    "json-ld",
    "structured-data",
    "schema.org",
    "react",
    "app-router"
  ],
  "license": "MIT",
  "author": "Mahesh Tavethiya",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tavethiya/next-seo-schema.git"
  },
  "homepage": "https://github.com/Tavethiya/next-seo-schema#readme",
  "bugs": "https://github.com/Tavethiya/next-seo-schema/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint src test",
    "prepublishOnly": "npm run type-check && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "schema-dts": "^1.1.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
